<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.BravePortal" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/brave_black</item>
        <item name="android:statusBarColor">@color/brave_black</item>
        <item name="android:navigationBarColor">@color/brave_black</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Shown by the system while the app starts (native splash) -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brave_black</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.BravePortal</item>
    </style>
</resources>
