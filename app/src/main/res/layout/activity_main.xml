<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brave_black">

    <!-- Normal portal UI. Padded for status bar / keyboard in MainActivity -->
    <FrameLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/brave_black">

        <WebView
            android:id="@+id/webView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <ProgressBar
            android:id="@+id/progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_gravity="top"
            android:max="100"
            android:progressTint="@color/brave_gold"
            android:visibility="gone" />

        <!-- Branded loading screen (same look as the splash) -->
        <LinearLayout
            android:id="@+id/loadingView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/brave_black"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp">

            <ImageView
                android:layout_width="240dp"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:contentDescription="@string/app_name"
                android:src="@drawable/brave_logo" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:fontFamily="serif"
                android:letterSpacing="0.45"
                android:text="@string/portal_label"
                android:textColor="@color/brave_gold_light"
                android:textSize="15sp"
                android:textStyle="bold" />

            <ProgressBar
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginTop="36dp"
                android:indeterminate="true"
                android:indeterminateTint="@color/brave_gold" />

            <TextView
                android:id="@+id/loadingText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="@string/loading"
                android:textColor="@color/brave_text_muted"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Branded offline / error screen -->
        <LinearLayout
            android:id="@+id/offlineView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/brave_black"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="200dp"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:contentDescription="@string/app_name"
                android:src="@drawable/brave_logo" />

            <TextView
                android:id="@+id/offlineTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:gravity="center"
                android:text="@string/offline_title"
                android:textColor="@color/brave_gold_light"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/offlineMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="@string/offline_message"
                android:textColor="@color/brave_text_muted"
                android:textSize="15sp" />

            <Button
                android:id="@+id/retryButton"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:layout_marginTop="28dp"
                android:background="@drawable/bg_button"
                android:backgroundTint="@null"
                android:minWidth="160dp"
                android:text="@string/retry"
                android:textAllCaps="false"
                android:textColor="@color/brave_black"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>

    <!-- Holds the fullscreen video view -->
    <FrameLayout
        android:id="@+id/fullscreenHost"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/brave_black"
        android:visibility="gone" />
</FrameLayout>
